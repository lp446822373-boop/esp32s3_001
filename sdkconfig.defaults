# WiFi 配网 + HTTP 服务需要更大的应用分区（1500 KB）
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# 手机浏览器请求头可能超过默认的 1 KB
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048

# 终端接口 HTTPS 客户端：使用内置 CA 证书包校验证书链和域名
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# 扫码结果提示音曲目编号（0 表示不播报），需与音频模块内的文件编号一致
CONFIG_CANTEEN_VOICE_TRACK_SUCCESS=2
CONFIG_CANTEEN_VOICE_TRACK_FAILED=4
CONFIG_CANTEEN_VOICE_TRACK_PENDING=1
CONFIG_CANTEEN_VOICE_TRACK_UNCONFIRMED=3
